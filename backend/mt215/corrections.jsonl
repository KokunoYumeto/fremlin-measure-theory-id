{"classification":"mathematical-type-error","correction_applied":true,"id":"O007-CORR-0087","math_ordinal":363,"provenance":{"basis":"exact current source-correction ledger row","kind":"source-correction-ledger","source_resource_ids":["O007-RESOURCE-CH21-SOURCE-CORRECTIONS"]},"rationale":"A measure takes a numerical extended-real value, not the empty set.  The defining disjointness-modulo-null condition is that each pairwise intersection has measure zero.","record_type":"source_correction","rights_id":"O007-RIGHTS-FREMLIN-DSL","schema_version":"1.1.0","source_locator":"authority/fremlin/source/mt2.2016/mt215.tex:376","source_normalized_sha256":"285f02b0b717cef550c33b0ef010362e5570c6df9c9e580aab8cbccb710c8a07","source_text":"$\\mu(E\\cap F)=\\emptyset$","target_locator":"source/id-ID/mt215.tex:398","target_normalized_sha256":"70e7aa8d7153a26a8a3e1419c449b53fbcbde8c93c18b19a043d25de4d9032b3","target_text":"$\\mu(E\\cap F)=0$","unit_id":"O007-FREMLIN-V2-S215"}
