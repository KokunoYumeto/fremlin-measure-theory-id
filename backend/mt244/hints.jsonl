{"exercise_id":"O007-FREMLIN-V2-S244-EXERCISE-244YK","hint_ordinal":2,"id":"O007-FREMLIN-V2-S244-HINT-244YK-02","provenance":{"basis":"active Hint macro associated with 244Yk","kind":"source-derived-hint-map"},"record_type":"hint","rights_id":"O007-RIGHTS-FREMLIN-DSL","schema_version":"1.1.0","segment_id":"O007-FREMLIN-V2-S244-SEG-244YK","semantic_anchor":"244Yk","source_anchor":"244Yk","source_line_start":1464,"source_raw_tex_sha256":"41b4ef44ccec39e9025acdcd07ab70904a832f1778882066d7b2fa80a5341a9e","source_text":"take $Pu$ to be the point of\n$V$ nearest to $u$.","target_line_start":1501,"target_raw_tex_sha256":"8dec78f576eba7655c93ab24ad19ebe5be3ca2dab7d1d48c44387ffef540cf00","target_text":"ambil $Pu$ sebagai titik $V$ yang\nterdekat dengan $u$.","unit_id":"O007-FREMLIN-V2-S244"}
