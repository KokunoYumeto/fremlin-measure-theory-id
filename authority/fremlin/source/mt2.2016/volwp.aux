\def\picturewithpsfig#1#2{\bigskip
   \immediate\write0{importing diagram #1.ps at height #2 with psfig}
   \vbox{\hsize\pagewidth
%\centerline{\discrversionA{\hskip1truein}{}\psfig{figure=#1.ps,height=#2
   \centerline{\psfig{figure=#1.ps,height=#2}}
   \medskip
   \centerline{\Caption}}
   \medskip
   \def\Caption{}}

\def\copyrightdate#1{}

\def\vtmpb#1{}
\newif\iflulu
\newif\iflargelogo
\def\discrpage{\vskip0pt plus\pageheight minus 0pt}
\def\frnewpage{}
\def\varfrnewpage{\vskip \pageheight plus 0pt minus\pageheight  
           \eject  
           \gdef\topparagraph{}  
           \gdef\bottomparagraph{}  
           \baselineskip=12pt
	   \footmarkcount=0}  
\def\leftfootline{}
\def\rightfootline{}
\def\query{\immediate\write0{query}\advance\nquery by 1}
\newcount\nquery
\nquery=0

\def\newsection#1{\wheader{\S#1 {\it intro.}}{24}{12}{2}{100pt}
   \vskip 0.1pt
   \noindent{\bf #1 \sectionname}
   \smallskip
   \let\headlinesectionname=\sectionname}
\def\newvolume#1{}

\newdimen\basiclineskip
\basiclineskip=12pt
\def\resetbaselineskip{\baselineskip=\basiclineskip}
\def\advancebaselineskip{\advance\baselineskip by 0.2pt}

\def\mtlulustyle{\lulutrue
  \noamslogo
  \firstpagefalse
  \resultsonlyfalse
  \magnification=\magstep0  
  \overfullrule0pt  
%  \def\pageheight{24.01truecm}  %4II 2013
     %allowing 1.25cm top and bottom, with 0.8 cm for header line
%  \def\pagewidth{18.12truecm}  %4II 2013
\def\pageheight{23.5truecm}  %5 2015
\def\pagewidth{17.75truecm}  %5 2015
  \hsize\pagewidth  
  \vsize\pageheight  
  \def\folio{\ifnum\pageno<5{}\else\number\pageno\fi} 
%  \lhoffset=-0.97truecm\rhoffset=-0.63truecm
     %mt2.2010
     %mt4.2013
       % using dvipdfm -p letter & ps2pdf14 
     %mt5.2013 first attempt at 5I;  
       % using dvipdfm -p letter & ps2pdf14 
       % l-h pages 1.0 cm from edge, r-h pages 1.5 cm from edge
       % difference evident in version from gpdf in Auster
  \lhoffset=-0.8truecm\rhoffset=-0.3truecm
     %mt5.2013 first attempt at 5II
       % using dvipdfm -p letter & ps2pdf14 
       % difference not strongly evident in version from gpdf in Auster
       % but l-h pages maybe 0.1 cm closer to edge than r-h pages
       % and this visible in "download and preview" version from
       %  Lulu, though scaling hard to estimate
  \global\voffset=-1.0cm
     %to be used with dvipdfm -p letter & ps2pdf14 
     %3-I, second attempt
     %mt4.2013
     %mt5.2013
  \stylenumber=12}

% actual page size   20.6 approx *27.3
