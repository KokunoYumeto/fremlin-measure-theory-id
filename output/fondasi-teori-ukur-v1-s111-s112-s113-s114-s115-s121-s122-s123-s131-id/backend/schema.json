{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O007 Fremlin modular backend record",
  "description": "Schema v1 for deterministic corpus controls and lossless source-to-id-ID unit records. It remains compatible with the original control records while adding first-class semantic records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "id", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"enum": ["corpus", "volume", "unit", "rights", "resource", "segment", "definition", "result", "proof", "exercise", "hint", "relation", "xref", "term", "formula", "artifact", "qa_event", "build_event"]},
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$"},
    "role_id": {"type": "string"},
    "corpus_id": {"type": "string"},
    "volume_id": {"type": "string"},
    "unit_id": {"type": "string"},
    "rights_id": {"type": "string"},
    "parent_id": {"type": "string"},
    "segment_id": {"type": "string"},
    "exercise_id": {"type": "string"},
    "subject_id": {"type": "string"},
    "object_id": {"type": "string"},
    "source_creator": {"type": "string"},
    "source_title": {"type": "string"},
    "subtitle": {"type": "string"},
    "target_locale": {"type": "string"},
    "target_working_title": {"type": "string"},
    "status": {"enum": ["selected", "queued", "in_progress", "admitted", "complete", "frozen"]},
    "outcome": {"enum": ["pass", "fail", "not_run"]},
    "included_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "excluded_scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "official_pages_total": {"type": "integer", "minimum": 1},
    "ordinal": {"type": "integer", "minimum": 1},
    "order": {"type": "integer", "minimum": 1},
    "official_pages": {"type": "integer", "minimum": 1},
    "active_exercise_problem_id_count": {"type": "integer", "minimum": 0},
    "explicit_hint_macro_count": {"type": "integer", "minimum": 0},
    "source_package_label": {"type": "string"},
    "source_resource_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_anchor": {"type": "string"},
    "semantic_anchor": {"type": "string"},
    "target_anchor": {"type": "string"},
    "anchor_kind": {"enum": ["explicit", "implicit-subanchor", "unmarked-unit-introduction", "synthesized-semantic-clause", "unit-metadata"]},
    "anchor_is_synthesized": {"type": "boolean"},
    "anchor_note": {"type": "string"},
    "source_member": {"type": "string"},
    "source_pages": {"type": "string"},
    "source_bytes": {"type": "integer", "minimum": 0},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_lines": {"type": "integer", "minimum": 0},
    "target_bytes": {"type": "integer", "minimum": 0},
    "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_lines": {"type": "integer", "minimum": 0},
    "source_line_start": {"type": "integer", "minimum": 1},
    "source_line_end": {"type": "integer", "minimum": 1},
    "target_line_start": {"type": "integer", "minimum": 1},
    "target_line_end": {"type": "integer", "minimum": 1},
    "source_char_start": {"type": "integer", "minimum": 0},
    "source_char_end": {"type": "integer", "minimum": 0},
    "target_char_start": {"type": "integer", "minimum": 0},
    "target_char_end": {"type": "integer", "minimum": 0},
    "source_segment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_segment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_label": {"type": "string"},
    "target_label": {"type": "string"},
    "segment_kind": {"type": "string"},
    "source_text": {"type": "string"},
    "target_text": {"type": "string"},
    "source_raw_tex": {"type": "string"},
    "target_raw_tex": {"type": "string"},
    "source_raw_tex_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_raw_tex_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalized_symbolic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "math_delimiter": {"enum": ["$", "$$"]},
    "formula_count": {"type": "integer", "minimum": 0},
    "exercise_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "explicit_hint_count": {"type": "integer", "minimum": 0},
    "target_path": {"type": "string"},
    "target_admitted": {"type": "boolean"},
    "license_name": {"type": "string"},
    "license_identifier": {"type": "string"},
    "applies_to": {"type": "string"},
    "derivative_allowed": {"type": "boolean"},
    "redistribution_allowed": {"type": "boolean"},
    "fee_distribution_allowed": {"type": "boolean"},
    "no_additional_restrictions": {"type": "boolean"},
    "conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "component_boundary": {"type": "string"},
    "resource_kind": {"type": "string"},
    "artifact_kind": {"type": "string"},
    "uri": {"type": "string"},
    "local_path": {"type": "string"},
    "bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {"type": "integer", "minimum": 0},
    "file_count": {"type": "integer", "minimum": 0},
    "expanded_bytes": {"type": "integer", "minimum": 0},
    "relation": {"type": "string"},
    "relation_type": {"type": "string"},
    "verification_status": {"type": "string"},
    "resolution_status": {"enum": ["resolved-in-unit", "selected-corpus-pending", "outside-selected-corpus-unresolved"]},
    "target_reference": {"type": "string"},
    "source_locator": {"type": "string"},
    "target_locator": {"type": "string"},
    "external_work": {"type": "string"},
    "importance": {"type": "boolean"},
    "importance_basis": {"type": "string"},
    "hint_ordinal": {"type": "integer", "minimum": 1},
    "source_term": {"type": "string"},
    "target_term": {"type": "string"},
    "term_kind": {"type": "string"},
    "definition_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "association_locator": {"type": "string"},
    "event_kind": {"type": "string"},
    "event_date": {"type": "string", "format": "date"},
    "validator": {"type": "string"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "basis"],
      "properties": {
        "kind": {"type": "string"},
        "basis": {"type": "string"},
        "source_resource_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  },
  "oneOf": [
    {"properties": {"record_type": {"const": "corpus"}}, "required": ["role_id", "source_creator", "source_title", "target_locale", "target_working_title", "status", "included_ids", "excluded_scope", "official_pages_total", "active_exercise_problem_id_count", "explicit_hint_macro_count", "rights_id"]},
    {"properties": {"record_type": {"const": "volume"}}, "required": ["corpus_id", "ordinal", "source_title", "subtitle", "official_pages", "active_exercise_problem_id_count", "explicit_hint_macro_count", "source_package_label", "status", "rights_id", "source_resource_ids"]},
    {"properties": {"record_type": {"const": "unit"}}, "required": ["corpus_id", "volume_id", "source_anchor", "source_member", "source_title", "target_working_title", "source_pages", "source_bytes", "source_sha256", "source_lines", "exercise_ids", "explicit_hint_count", "target_path", "target_admitted", "status", "rights_id", "source_resource_ids"]},
    {"properties": {"record_type": {"const": "rights"}}, "required": ["license_name", "license_identifier", "applies_to", "derivative_allowed", "redistribution_allowed", "fee_distribution_allowed", "no_additional_restrictions", "conditions", "component_boundary", "source_resource_ids", "status"]},
    {"properties": {"record_type": {"const": "resource"}}, "required": ["resource_kind", "local_path", "bytes", "sha256", "relation", "verification_status"]},
    {"properties": {"record_type": {"const": "segment"}}, "required": ["unit_id", "order", "source_anchor", "semantic_anchor", "anchor_kind", "anchor_is_synthesized", "segment_kind", "source_line_start", "source_line_end", "target_line_start", "target_line_end", "source_char_start", "source_char_end", "target_char_start", "target_char_end", "source_segment_sha256", "target_segment_sha256"]},
    {"properties": {"record_type": {"const": "definition"}}, "required": ["unit_id", "segment_id", "source_anchor", "source_term", "target_term", "source_text", "target_text"]},
    {"properties": {"record_type": {"const": "result"}}, "required": ["unit_id", "segment_id", "source_anchor", "source_label", "target_label", "source_text", "target_text"]},
    {"properties": {"record_type": {"const": "proof"}}, "required": ["unit_id", "segment_id", "source_anchor", "association_locator", "source_line_start", "target_line_start", "source_raw_tex_sha256", "target_raw_tex_sha256"]},
    {"properties": {"record_type": {"const": "exercise"}}, "required": ["unit_id", "segment_id", "source_anchor", "semantic_anchor", "order", "importance", "importance_basis", "source_text", "target_text"]},
    {"properties": {"record_type": {"const": "hint"}}, "required": ["unit_id", "exercise_id", "segment_id", "source_anchor", "hint_ordinal", "source_text", "target_text", "source_raw_tex_sha256", "target_raw_tex_sha256"]},
    {"properties": {"record_type": {"const": "relation"}}, "required": ["unit_id", "subject_id", "relation_type", "object_id"]},
    {"properties": {"record_type": {"const": "xref"}}, "required": ["unit_id", "segment_id", "source_anchor", "order", "target_reference", "relation_type", "resolution_status", "source_locator"]},
    {"properties": {"record_type": {"const": "term"}}, "required": ["unit_id", "source_term", "target_term", "term_kind", "definition_ids"]},
    {"properties": {"record_type": {"const": "formula"}}, "required": ["unit_id", "segment_id", "source_anchor", "order", "source_line_start", "target_line_start", "source_char_start", "source_char_end", "target_char_start", "target_char_end", "math_delimiter", "source_raw_tex", "target_raw_tex", "source_raw_tex_sha256", "target_raw_tex_sha256", "normalized_symbolic_sha256"]},
    {"properties": {"record_type": {"const": "artifact"}}, "required": ["unit_id", "artifact_kind", "local_path", "bytes", "sha256", "verification_status", "rights_id"]},
    {"properties": {"record_type": {"const": "qa_event"}}, "required": ["unit_id", "event_kind", "event_date", "outcome", "validator", "checks", "counts"]},
    {"properties": {"record_type": {"const": "build_event"}}, "required": ["unit_id", "event_kind", "event_date", "outcome", "validator", "checks"]}
  ]
}
